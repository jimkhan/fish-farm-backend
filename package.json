{
  "name": "fish-farm-backend",
  "version": "0.1.0",
  "description": "FMS backend — NestJS modular monolith (Clean Architecture). Implements ../fish-farm-context-files/contracts/openapi.yaml.",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,packages}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --testPathPattern e2e-spec",
    "check:purity": "jest domain-purity",
    "prepare": "npm run packages:build",
    "packages:build": "npm run build --workspaces",
    "packages:pack": "npm run packages:build && mkdir -p dist-packages && npm pack --workspaces --pack-destination dist-packages",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/platform/persistence/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -p migrations/",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@fish-farm/calendar": "0.1.0",
    "@fish-farm/shared": "0.1.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^10.0.2",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "joi": "^17.13.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test",
      "<rootDir>/packages"
    ],
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "moduleNameMapper": {
      "^@fish-farm/(.*)$": "<rootDir>/packages/$1/src"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
