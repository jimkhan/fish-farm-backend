# TASK-048 (MOD-01, AC-140, NFR-010): single api image for the one-VPS Docker Compose topology.
# Single stage, devDependencies included: ts-node + the typeorm CLI stay in the runtime image so
# `npm run migration:run` works completely unmodified via the entrypoint, rather than inventing a
# second, dist-only migration entry point the rest of the codebase doesn't have. NFR-010 favors
# low operational complexity over image size for a single-VPS deployment.

FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache curl

COPY package*.json ./
COPY packages ./packages
# `npm install`, not `npm ci` — found during this task's own build verification: a lockfile
# regenerated by one npm version can fail `npm ci`'s stricter consistency check under a
# different npm minor version (host 10.8.2 vs this image's bundled 10.9.8, over a transitive
# ajv/json-schema-traverse resolution). The rest of this repo has never used `npm ci` either
# (every script/session workflow uses `npm install`) — matching that existing convention here is
# more robust than chasing exact npm-version parity for one Docker build step.
RUN npm install

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -sf http://localhost:3000/health | grep -q '"status":"ok"' || exit 1

RUN chmod +x ./docker/entrypoint.sh
ENTRYPOINT ["./docker/entrypoint.sh"]
