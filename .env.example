# Copy to .env for local development. Never commit real secrets (NFR-005).
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=fish_farm

# TASK-008: signs/verifies access-token JWTs (min 32 chars). Generate your own, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=changeme-generate-a-real-32-plus-character-secret
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30

# TASK-048 / TASK-036 (ADR-018): OpenWeather Current Weather API key for site weather.
# Optional — app boots without it; GET .../weather still serves the seed/cache, but cron and
# POST .../weather/refresh cannot pull live data until this is set.
# OPENWEATHER_API_KEY=

# TASK-048 (MOD-01, ADR-012): provisioned for TASK-035's camera-config endpoint — the per-site
# MediaMTX service's base URL, reachable from the api container on the compose network. Optional;
# app boots fine without it. In docker-compose.yml this defaults to http://media-server:9997.
# MEDIA_SERVER_BASE_URL=

# TASK-049 (MOD-01, AC-141, NFR-008): required in production — the `backup` compose service
# fails fast without these (docker-compose.local.yml overrides all three with a local MinIO
# stand-in, so none of this is needed for local/no-cloud testing). `BACKUP_S3_REMOTE` is an
# rclone remote:path, e.g. `s3:my-bucket/fms-backups`. See DEPLOYMENT.md "Backups & restore".
# BACKUP_S3_REMOTE=s3:my-bucket/fms-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Optional — only needed for non-AWS S3-compatible providers (DigitalOcean Spaces, Backblaze B2,
# self-hosted MinIO, ...). Leave unset for real AWS S3.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PROVIDER=Other
# BACKUP_S3_REGION=
# Optional — defaults shown; retention is a documented judgment call (BACKLOG names no number).
# BACKUP_RETENTION_DAYS=14
# BACKUP_CRON_SCHEDULE=0 2 * * *

# ---- docker-compose.yml only (not read by the Nest app itself) ----
# Postgres container init (mirrors DB_USERNAME/DB_PASSWORD/DB_NAME above — one secret source).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=123456
# POSTGRES_DB=fish_farm
# Caddy TLS: a real public domain + contact email for automatic Let's Encrypt in production.
# Leave DOMAIN unset (or use docker-compose.local.yml) for self-signed local/no-DNS testing.
# DOMAIN=api.example.com
# ACME_EMAIL=ops@example.com
