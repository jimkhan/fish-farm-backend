# Copy to .env for local development. Never commit real secrets (NFR-005).
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=fish_farm

# TASK-008: signs/verifies access-token JWTs (min 32 chars). Generate your own, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=changeme-generate-a-real-32-plus-character-secret
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30
